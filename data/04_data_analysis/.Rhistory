scale_x_discrete(labels=c(not_fixated = "Fixation = 0", fixated = "Fixation = 1", very_fixated = "Fixation > 1")) +
scale_y_continuous(breaks = seq(floor(min(data$total_recall)), ceiling(max(data$total_recall)), by = 2)) +
