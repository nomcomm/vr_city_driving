df <- read_csv('documents_df.csv')
df$combination <- paste(df$partisan, df$media_type, df$Topic, sep = "_")
df_count_test <- df %>%
group_by(publish_date, combination) %>%
summarise(counts = n(), .groups = "drop") %>%
arrange(publish_date)
df_count <- df_count_test  %>%
group_by(combination) %>%
complete(publish_date = seq.Date(min(publish_date), max(publish_date), by="day"),
fill = list(counts = 0))  %>%
arrange(publish_date)
class(df_count$publish_date)
df_count$week <- floor_date(df_count$publish_date, "week")
class(df_count$week)
df_pivot0 <- df_count  %>%
pivot_wider(names_from = combination, values_from = counts, values_fill = 0)
df_pivot <- df_pivot0  %>% filter(publish_date >= "2020-05-24")
df_pivot$publish_date
unique(df_pivot$week)
#topic0
columns_topic0 <- grep("_0$", names(df_pivot), value = TRUE)
df_topic0 <- df_pivot[, c("week", "publish_date", columns_topic0)]
df_topic0
right_blog_0_weekly <- df_topic0 %>%
group_by(week) %>%
summarize(right_blog_0 = sum(right_blog_0))
ggplot(right_blog_0_weekly, aes(x = week, y = right_blog_0)) +
geom_line() +
labs(x = "Date", y = "Count") +
theme_minimal() +
scale_x_date(date_breaks = "6 month", date_labels = "%Y-%m")
right_blog_0_weekly_ts <- zoo(right_blog_0_weekly$right_blog_0, order.by = right_blog_0_weekly$week)
print(right_blog_0_weekly_ts, calendar=TRUE)
right_blog_0_weekly_ts %>% ggtsdisplay(main="")
adf.test(right_blog_0_weekly_ts)
kpss.test(right_blog_0_weekly_ts)#trend
right_blog_0_weekly_ts %>% diff() %>% ggtsdisplay(main="")
adf.test(diff(right_blog_0_weekly_ts))
